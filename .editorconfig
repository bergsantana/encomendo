root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
# Compose names UI functions in PascalCase; the rule would reject every @Composable.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Compose Multiplatform generates resource accessors under build/. They are
# generated code: lint our sources, never the generator's output. (The ktlint
# Gradle filter does not reach a source set rooted in the generated directory.)
[**/build/generated/**]
ktlint = disabled
