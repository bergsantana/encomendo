# Copy to .env (make setup does it). Local development only: no real secrets here.
#
# Running several worktrees at once? Give each its own project name and ports.
COMPOSE_PROJECT_NAME=encomendo
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8081
WEB_PORT=8080          # nginx stack (make stack-up)
ADMIN_PORT=5173        # Vite admin (make dev-up)
STORE_PORT=5174        # Vite store (make dev-up)

# Used by `make -C backend run` and `make -C backend migrate-up` outside Docker.
APP_ENV=development
LOG_FORMAT=text
LOG_LEVEL=debug
DATABASE_URL=postgres://encomendo_app:encomendo_app_dev@localhost:5432/encomendo?sslmode=disable
MIGRATE_DATABASE_URL=postgres://encomendo_owner:encomendo_owner_dev@localhost:5432/encomendo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# The fixed development keys and plain-HTTP settings, refused outside
# development (ADRs 0010, 0011 and 0019). Mail goes to Mailpit.
AUTH_SIGNING_SEED=augERHUoTDTq1K69k5GLuA1cZM6mNFE3RPy9bYzpj08=
AUTH_RESET_CODE_KEY=AxEa9VTpecLRcumgvGFhpYTkZR2pF4jzai/nIen2Dtk=
AUTH_REFRESH_COOKIE=encomendo_refresh
ADMIN_ORIGIN=http://localhost:5173
SMTP_ADDR=localhost:1025
SMTP_FROM=nao-responda@encomendo.localhost
SMTP_REQUIRE_TLS=false
MAILPIT_PORT=8025      # Mailpit web UI and API: http://localhost:8025
MAILPIT_SMTP_PORT=1025 # Mailpit SMTP, for an API run on the host
# Photos: the compose MinIO (ADR 0028), for an API run on the host too.
MINIO_PORT=9000
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_ENDPOINT=localhost:9000
STORAGE_BUCKET=encomendo-photos
STORAGE_ACCESS_KEY=encomendo
STORAGE_SECRET_KEY=encomendo_minio_dev
STORAGE_USE_SSL=false
