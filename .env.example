# Copy to .env (make setup does it). Local development only: no real secrets here.
#
# Running several worktrees at once? Give each its own project name and ports.
COMPOSE_PROJECT_NAME=encomendo
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8081
WEB_PORT=8080          # nginx stack (make stack-up)
ADMIN_PORT=5173        # Vite admin (make dev-up)
STORE_PORT=5174        # Vite store (make dev-up)

# Used by `make -C backend run` and `make -C backend migrate-up` outside Docker.
APP_ENV=development
LOG_FORMAT=text
LOG_LEVEL=debug
DATABASE_URL=postgres://encomendo_app:encomendo_app_dev@localhost:5432/encomendo?sslmode=disable
MIGRATE_DATABASE_URL=postgres://encomendo_owner:encomendo_owner_dev@localhost:5432/encomendo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
