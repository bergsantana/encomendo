# Copy to deploy/.env.prod (gitignored) and fill in every value.
# Generate secrets with: openssl rand -hex 24   (hex is safe inside URLs)

COMPOSE_PROJECT_NAME=encomendo
IMAGE_REPO=ghcr.io/bergsantana/encomendo
VERSION=0.0.0

ADMIN_HOST=admin.encomendo.com.br
API_HOST=api.encomendo.com.br
# Where a store's page lives, for tracking links. {slug} is the store's
# address and must appear once; https is required.
STORE_ORIGIN_TEMPLATE=https://{slug}.encomendo.com.br

POSTGRES_PASSWORD=
ENCOMENDO_OWNER_PASSWORD=
ENCOMENDO_APP_PASSWORD=
REDIS_PASSWORD=

# Access tokens (ADR 0019): openssl rand -base64 32. During a key rotation,
# the previous seeds go in AUTH_VERIFY_SEEDS, comma-separated.
AUTH_SIGNING_SEED=
AUTH_VERIFY_SEEDS=
# Reset codes and the rate limits' pseudonyms (ADRs 0011 and 0021):
# openssl rand -base64 32.
AUTH_RESET_CODE_KEY=

# Mail for invitations and reset codes. The server must offer STARTTLS.
SMTP_ADDR=smtp.example.com:587
SMTP_FROM=nao-responda@encomendo.com.br
SMTP_USERNAME=
SMTP_PASSWORD=

# Photos on Cloudflare R2 (ADRs 0023, 0024 and 0028).
# - STORAGE_ENDPOINT is the account's S3 host, without https:// or a path:
#   {account id}.r2.cloudflarestorage.com. Signed upload and read URLs name
#   it too, so the browsers and phones reach R2 directly.
# - The token (R2 > Manage API tokens) needs Object Read & Write on this
#   bucket only. The secret is shown once; never log or commit it.
# - The bucket needs, once, set in the Cloudflare dashboard or with wrangler:
#   - CORS: allow PUT and GET from https://${ADMIN_HOST} only, with the
#     Content-Type header (Android needs no CORS);
#   - a lifecycle rule: delete objects with the prefix "uploads/" one day
#     after upload. Only uploads never confirmed are left there; confirmed
#     photos live under "t/" and must never expire.
#   - no public access: photos are read through signed URLs.
STORAGE_ENDPOINT=0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
STORAGE_BUCKET=encomendo-photos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
