# One config for every environment. ADMIN_HOST is substituted at container
# start (admin.localhost locally, admin.encomendo.com.br in production).
# It serves the admin app; any other host serves the store app, which reads
# the tenant slug from the host (altarpm.localhost, altarpm.encomendo.com.br).
# API paths go to the api service on the same origin, so no CORS is needed.

server {
  listen 8080;
  server_name ${ADMIN_HOST};
  root /usr/share/nginx/admin;

  location ~ ^/(api|auth|healthz|readyz)(/|$) {
    proxy_pass http://api:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

server {
  listen 8080 default_server;
  server_name _;
  root /usr/share/nginx/store;

  location ~ ^/(api|auth|healthz|readyz)(/|$) {
    proxy_pass http://api:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
