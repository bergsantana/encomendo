# One config for every environment. ADMIN_HOST is substituted at container
# start (admin.localhost locally, admin.encomendo.com.br in production).
# It serves the admin app; any other host serves the store app, which reads
# the tenant slug from the host (altarpm.localhost, altarpm.encomendo.com.br).
# API paths go to the api service on the same origin, so no CORS is needed.

# The access log never holds a query string or a tracking token. Searches
# carry customers' names and WhatsApp numbers (?q=), invitation and reset
# links carry codes, and /p/{token} is the client's tracking link, which the
# API stores only as a hash (backend/CLAUDE.md, Logging). So the log line has
# the path without "?…", and the token after /p/ or /track/ masked.
map $request_uri $encomendo_log_path {
  "~^/p/"                     "/p/[token]";
  "~^(?<encomendo_pre>[^?]*/track/)" "${encomendo_pre}[token]";
  "~^(?<encomendo_bare>[^?]*)" $encomendo_bare;
}

log_format encomendo '$remote_addr [$time_local] "$request_method $encomendo_log_path" '
                     '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
  listen 8080;
  server_name ${ADMIN_HOST};
  root /usr/share/nginx/admin;
  # Per server, so it replaces the image's http-level log, which writes the
  # whole request line, query included.
  access_log /dev/stdout encomendo;

  location ~ ^/(api|auth|healthz|readyz)(/|$) {
    proxy_pass http://api:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The apps never need to send their URL to another site. Set here, not
  # on the server, so API answers keep the API's own no-referrer.
  # The admin frames only itself and nobody frames it: in the Android shell
  # a frame of another site would run beside the session (ADR 0029). Frame
  # directives only, so scripts and styles are untouched.
  location / {
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "frame-src 'self'; frame-ancestors 'none'" always;
    try_files $uri $uri/ /index.html;
  }

  # A cached index.html would keep pointing at an old build's files.
  location = /index.html {
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "frame-src 'self'; frame-ancestors 'none'" always;
  }
}

server {
  listen 8080 default_server;
  server_name _;
  root /usr/share/nginx/store;
  access_log /dev/stdout encomendo;

  location ~ ^/(api|auth|healthz|readyz)(/|$) {
    proxy_pass http://api:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The apps never need to send their URL to another site. Set here, not
  # on the server, so API answers keep the API's own no-referrer.
  location / {
    add_header Referrer-Policy same-origin always;
    try_files $uri $uri/ /index.html;
  }

  # A cached index.html would keep pointing at an old build's files.
  location = /index.html {
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy same-origin always;
  }
}
