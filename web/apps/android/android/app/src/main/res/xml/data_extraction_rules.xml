<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later: nothing leaves the phone in a cloud backup or a
    device-to-device transfer. The WebView's data holds the refresh cookie,
    which must never be restored on another device (ADR 0010).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
